{
    "name": "@truedxf/three",
    "version": "0.1.1",
    "description": "Fast three.js (WebGL) renderer for truedxf: AutoCAD-accurate DXF drawings in the browser.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tth05/truedxf.git",
        "directory": "packages/three"
    },
    "homepage": "https://github.com/tth05/truedxf/tree/master/packages/three#readme",
    "bugs": "https://github.com/tth05/truedxf/issues",
    "keywords": [
        "dxf",
        "three.js",
        "webgl",
        "cad"
    ],
    "type": "module",
    "sideEffects": [
        "./src/index.ts",
        "./dist/index.js"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./merge": "./src/merge.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./merge": {
                "types": "./dist/merge.d.ts",
                "default": "./dist/merge.js"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "dependencies": {
        "@truedxf/render": "workspace:^"
    },
    "peerDependencies": {
        "three": ">=0.170.0"
    },
    "devDependencies": {
        "@types/three": "^0.186.0",
        "three": ">=0.170.0"
    }
}
