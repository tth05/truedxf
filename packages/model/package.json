{
    "name": "@truedxf/model",
    "version": "0.1.1",
    "description": "Fast, lossless DXF parser with a typed document model. Reads real-world files from R12 to 2018+, ASCII and binary.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tth05/truedxf.git",
        "directory": "packages/model"
    },
    "homepage": "https://github.com/tth05/truedxf/tree/master/packages/model#readme",
    "bugs": "https://github.com/tth05/truedxf/issues",
    "keywords": [
        "dxf",
        "cad",
        "autocad",
        "document-model"
    ],
    "type": "module",
    "sideEffects": [
        "./src/entities/*.ts",
        "./src/*.ts",
        "./dist/entities/*.js",
        "./dist/*.js"
    ],
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "dependencies": {
        "@truedxf/core": "workspace:^"
    }
}
