{
  "name": "@truedxf/render",
  "version": "0.0.0",
  "description": "Rendering frontend: layouts, viewports, blocks, properties, draw order to a renderer-agnostic display list",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@truedxf/core": "workspace:*",
    "@truedxf/fonts": "workspace:*",
    "@truedxf/geometry": "workspace:*",
    "@truedxf/model": "workspace:*",
    "@truedxf/plot": "workspace:*",
    "@truedxf/text": "workspace:*",
    "earcut": "^3.2.4"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0"
  }
}
