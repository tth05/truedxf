{
    "name": "@truedxf/plot",
    "version": "0.1.1",
    "description": "CTB/STB plot styles and DXF page setups: pens, lineweights and plot transforms exactly as AutoCAD plots them.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tth05/truedxf.git",
        "directory": "packages/plot"
    },
    "homepage": "https://github.com/tth05/truedxf/tree/master/packages/plot#readme",
    "bugs": "https://github.com/tth05/truedxf/issues",
    "keywords": [
        "dxf",
        "autocad",
        "ctb",
        "plot-styles"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "dependencies": {
        "@truedxf/core": "workspace:^",
        "@truedxf/model": "workspace:^",
        "fflate": "^0.8.3"
    }
}
