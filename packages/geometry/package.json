{
    "name": "@truedxf/geometry",
    "version": "0.1.1",
    "description": "Fast float64 CAD geometry: NURBS, arcs, ellipses, OCS, dashing, hatching, stroking and clipping, tuned to AutoCAD's output.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tth05/truedxf.git",
        "directory": "packages/geometry"
    },
    "homepage": "https://github.com/tth05/truedxf/tree/master/packages/geometry#readme",
    "bugs": "https://github.com/tth05/truedxf/issues",
    "keywords": [
        "cad",
        "nurbs",
        "hatch",
        "geometry"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "dependencies": {
        "clipper2-ts": "2.0.1-18",
        "earcut": "^3.2.4"
    }
}
