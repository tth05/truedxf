{
    "name": "@truedxf/fonts",
    "version": "0.1.0",
    "description": "SHX and TrueType fonts for DXF, with font lookup and fallback that pick the same font AutoCAD does.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tth05/truedxf.git",
        "directory": "packages/fonts"
    },
    "homepage": "https://github.com/tth05/truedxf/tree/master/packages/fonts#readme",
    "bugs": "https://github.com/tth05/truedxf/issues",
    "keywords": [
        "shx",
        "autocad",
        "fonts",
        "ttf"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "dependencies": {
        "opentype.js": "^2.0.0"
    },
    "devDependencies": {
        "@types/opentype.js": "^1.3.10"
    }
}
