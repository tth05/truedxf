      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10"
  }
