{
    "name": "@truedxf/viewer",
    "version": "0.1.0",
    "description": "Fast, embeddable web DXF viewer that draws like AutoCAD plots. Worker parsing, layouts, layers, picking and measuring.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tth05/truedxf.git",
        "directory": "packages/viewer"
    },
    "homepage": "https://github.com/tth05/truedxf/tree/master/packages/viewer#readme",
    "bugs": "https://github.com/tth05/truedxf/issues",
    "keywords": [
        "dxf",
        "viewer",
        "cad",
        "autocad",
        "three.js",
        "webgl"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts",
        "./core": "./src/core.ts",
        "./worker": "./src/worker.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "./core": {
                "types": "./dist/core.d.ts",
                "default": "./dist/core.js"
            },
            "./worker": {
                "types": "./dist/worker.d.ts",
                "default": "./dist/worker.js"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "dependencies": {
        "@truedxf/core": "workspace:^",
        "@truedxf/model": "workspace:^",
        "@truedxf/pdf": "workspace:^",
        "@truedxf/render": "workspace:^",
        "@truedxf/text": "workspace:^",
        "@truedxf/three": "workspace:^",
        "flatbush": "^4.6.2"
    },
    "peerDependencies": {
        "three": ">=0.170.0"
    },
    "devDependencies": {
        "@types/three": "^0.186.0",
        "three": "^0.186.1"
    }
}
