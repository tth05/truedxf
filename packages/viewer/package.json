{
  "name": "@truedxf/viewer",
  "version": "0.0.0",
  "description": "Embeddable DXF viewer: worker pipeline, pan/zoom, layouts, layers, picking",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./worker": "./src/worker.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "default": "./dist/worker.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@truedxf/core": "workspace:*",
    "@truedxf/model": "workspace:*",
    "@truedxf/render": "workspace:*",
    "@truedxf/three": "workspace:*",
    "flatbush": "^4.6.2"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1"
  }
}
