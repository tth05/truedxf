{
    "name": "@truedxf/core",
    "version": "0.1.1",
    "description": "Fast, lossless DXF tokenizer for ASCII and binary files. Keeps every decoded group code and decodes every code page.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tth05/truedxf.git",
        "directory": "packages/core"
    },
    "homepage": "https://github.com/tth05/truedxf/tree/master/packages/core#readme",
    "bugs": "https://github.com/tth05/truedxf/issues",
    "keywords": [
        "dxf",
        "parser",
        "cad",
        "autocad"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/index.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ]
}
